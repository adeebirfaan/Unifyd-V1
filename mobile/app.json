{
  "expo": {
    "name": "Unifyd",
    "slug": "unifyd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/unifyd-logo.png",
    "scheme": "unifyd",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/brand/unifyd-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/unifyd-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#007AFB",
          "defaultChannel": "unifyd-task-reminders"
        }
      ],
      [
        "./plugins/withUnifydNotificationLargeIcon",
        {
          "largeIcon": "./assets/brand/notification-large-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Unifyd to select a receipt photo for text extraction.",
          "cameraPermission": "Allow Unifyd to photograph a receipt for text extraction.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/unifyd-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
